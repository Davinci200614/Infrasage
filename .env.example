# PostgreSQL connection for the voting-app database (when lab is running)
# Adjust host/port/db/user/pass to match lab/docker-compose.infrasage.yml
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/postgres

# Redis connection (when lab is running)
REDIS_URL=redis://localhost:6379

# GitHub token for github MCP server (create at github.com/settings/tokens)
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxx
