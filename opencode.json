{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "servers": {
      "docker": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-docker-server"
        ]
      },
      "postgres": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-postgres",
          "postgresql://postgres:postgres@localhost:5432/postgres"
        ]
      },
      "redis": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-redis",
          "redis://localhost:6379"
        ]
      },
      "fs": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "."
        ]
      },
      "git": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-git",
          "."
        ]
      },
      "github": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.config/opencode/github.token}"
        }
      },
      "netdata": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-netdata",
          "http://127.0.0.1:19999"
        ]
      },
      "energy": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-python",
          "http://127.0.0.1:5001"
        ]
      }
    }
  }
}
